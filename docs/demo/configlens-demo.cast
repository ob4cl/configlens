[0.070122, "o", "ConfigLens — the same key, set in three layers\r\nsandbox: $SCRATCH/configlens-record.257539 (synthetic values only, deleted on exit)\r\n\r\n--- the layers, lowest precedence first (cc.user → cc.project_shared → cc.project_local) ---\r\n"]
[0.070933, "o", "\r\n$ cat ~/.claude/settings.json\r\n"]
[0.074684, "o", "{ \"model\": \"user-layer-model\" }\r\n"]
[0.075374, "o", "$ cat ./.claude/settings.json\r\n"]
[0.079755, "o", "{ \"model\": \"project-layer-model\" }\r\n"]
[0.080524, "o", "$ cat ./.claude/settings.local.json\r\n"]
[0.085296, "o", "{ \"model\": \"local-layer-model\" }\r\n"]
[0.086019, "o", "\r\n$ configlens explain /model --client claude --client-version 2.1.296\r\n"]
[0.093708, "o", "/model = \"local-layer-model\" (observed)\r\nObserved winner: $PROJECT/.claude/settings.local.json:1:12  \"local-layer-model\"  observed_winner\r\nLosers:\r\n  \"user-layer-model\"  $HOME/.claude/settings.json:1:12  replaced_by_later_layer\r\n  \"project-layer-model\"  $PROJECT/.claude/settings.json:1:12  replaced_by_later_layer\r\nRule: claude.scalar.layer-override\r\nCoverage: partial — cc.managed.hkcu — registry_not_read (expected_unobservable); cc.managed.mdm — platform_policy_store_not_read (expected_unobservable); cc.managed.server — remote_source_not_fetched (expected_unobservable); cc.managed.file — managed_file_absent_does_not_prove_policy_absent (managed_state_unknown)\r\nSupport: fixture_verified; confidence: evidence_class:fixture_verified\r\nConclusion: \"local-layer-model\" wins among the observed applicable sources; effective value withheld.\r\nNext inspection:\r\n  - supply the managed settings file with --input-context to include it\r\n  - remote/MDM layers are not observable here; re-run where the managed source is readable\r\nDiagnostics (2):\r\n  [warning] trust_unknown  $PROJECT/.claude/settings.json  location unavailable\r\n  [warning] trust_unknown  $PROJECT/.claude/settings.local.json  location unavailable\r\n"]
[0.094817, "o", "\r\n--- the same resolution as JSON: every contribution keeps its source, line and reason ---\r\n\r\n$ configlens explain /model --client claude --client-version 2.1.296 --format json | jq '.resolutions[] | {pointer, status, observed_value, events: [.events[] | {kind, location, value}]}'\r\n"]
[0.102517, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"pointer\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"/model\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"partial\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"observed_value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"string\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"verified_model_name\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"local-layer-model\"\u001b[0m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"events\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"replaced\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"location\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"$HOME/.claude/settings.json:1:12\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n        \u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"string\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"verified_model_name\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"user-layer-model\"\u001b[0m\r\n      \u001b[1;39m}\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"replaced\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
[0.102592, "o", "      \u001b[1;34m\"location\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"$PROJECT/.claude/settings.json:1:12\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n        \u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"string\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"verified_model_name\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[1;34m\"value\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"project-layer-model\"\u001b[0m\r\n      \u001b[1;39m}\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
