---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Demo from "../components/Demo.astro";
import Process from "../components/Process.astro";
import Features from "../components/Features.astro";
import Terminal from "../components/Terminal.astro";
import Privacy from "../components/Privacy.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
const title = "ConfigLens — Know which config wins, and why";
const description =
  "Trace supported Claude Code and OpenCode settings to their observed winner. An offline, read-only Rust CLI with source provenance, redaction, and honest coverage gaps.";
const canonical = "https://ob4cl.github.io/configlens/";
const structured = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "ConfigLens",
  description,
  codeRepository: "https://github.com/ob4cl/configlens",
  url: canonical,
  programmingLanguage: "Rust",
  license: [
    "https://github.com/ob4cl/configlens/blob/main/LICENSE-MIT",
    "https://github.com/ob4cl/configlens/blob/main/LICENSE-APACHE",
  ],
  version: "0.1.0-beta.3",
};
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="theme-color" content="#101214" /><title>{title}</title><meta
      name="description"
      content={description}
    /><link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/configlens/favicon.svg"
      type="image/svg+xml"
    /><meta property="og:type" content="website" /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:image" content={`${canonical}og.png`} /><meta
      property="og:image:width"
      content="1200"
    /><meta property="og:image:height" content="630" /><meta
      property="og:image:alt"
      content="ConfigLens: Know which config wins. Trace user, project and local sources to the observed winner."
    /><meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={`${canonical}og.png`}
    /><script
      type="application/ld+json"
      set:html={JSON.stringify(structured)}
    /></head
  ><body
    ><Header /><main id="main">
      <Hero /><Demo /><Process /><Features /><Terminal /><Privacy /><Install />
    </main><Footer /><script>
      import "../scripts/site";
    </script></body
  >
</html>
